{
  "name": "odp-node",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Official Node.js packages for the Offering Discovery Protocol.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/offering-protocol/odp-node.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "build": "turbo run build",
    "benchmark": "pnpm build && node scripts/benchmark.mjs",
    "test": "turbo run test",
    "update:all": "pnpm update --recursive --depth Infinity",
    "coverage:changed": "node scripts/check-changed-coverage.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,js,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,json,md,yml,yaml}\"",
    "typedoc": "typedoc",
    "conformance": "node scripts/run-conformance.mjs",
    "smoke:examples": "node scripts/smoke-examples.mjs",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm coverage:changed && pnpm typedoc && pnpm build && pnpm verify:packages && pnpm smoke:examples && node scripts/benchmark.mjs",
    "verify:packages": "node scripts/verify-packages.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm verify:packages && changeset publish",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "turbo": "^2.10.12",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.7"
  }
}
