{
  "name": "odp-node",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Official Node.js packages for the Offering Discovery Protocol.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/offering-protocol/odp-node.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,yml,yaml}\"",
    "typedoc": "typedoc",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm typedoc && pnpm build && pnpm verify:packages",
    "verify:packages": "node scripts/verify-packages.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm verify:packages && changeset publish",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.0",
    "@types/node": "^26.1.2",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.0",
    "tsup": "^8.3.0",
    "turbo": "^2.2.0",
    "typedoc": "^0.28.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.6"
  }
}
