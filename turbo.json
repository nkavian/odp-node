{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["eslint.config.js", "tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "scripts/**",
        "tsconfig.json",
        "tsup.config.ts",
        "wrangler.json",
        "package.json"
      ],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "scripts/**",
        "test/**",
        "tsconfig.json",
        "tsconfig.test.json",
        "package.json"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "scripts/**",
        "test/**",
        "tsconfig.json",
        "tsconfig.test.json",
        "package.json"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "scripts/**",
        "test/**",
        "vitest.config.ts",
        "wrangler.json",
        "package.json"
      ],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
